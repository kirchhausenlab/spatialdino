  "version": "0.2.0",
  "configurations": [
    {
      "name": "save_files",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--save_3d",
        "--use_deskewed_data",
        "--dz",
        "0.25",
        "--dy",
        "0.104",
        "--dx",
        "0.104",
        "--z_flatten_mode",
        "NONE",
        "--z_chunk_size",
        "-1",
        "--y_chunk_size",
        "-1",
        "--x_chunk_size",
        "-1",
        "--data_paths_txt",
        "/nfs/scratch2/shared_image_recog_ml/annotations/experiment_paths.txt",
        "--save_path",
        "/nfs/scratch2/shared_image_recog_ml/llsm_3d_ds_auto_crop_sharded_v2",
        "--experiment_filter_pattern",
        "(?i)(dextran|lamp1|npc1|eea1|transferrin)",
        "--found_experiments_limit",
        "1000",
        "--min_tif_files",
        "20",
        "--max_workers",
        "1",
        "--auto_crop"
      ]
    },
    {
      "name": "pretrain",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "torch.distributed.run",
      "justMyCode": false,
      "env": {
        "NCCL_SOCKET_IFNAME": "ib",
        "NCCL_SOCKET_NTHREADS": "4",
        "NCCL_NSOCKS_PERTHREAD": "4",
        "OMP_NUM_THREADS": "16"
      },
      "args": [
        "--nnodes",
        "1",
        "--node_rank",
        "0",
        "--nproc_per_node",
        "1",
        "--rdzv-id",
        "2000",
        "--rdzv-backend",
        "c10d",
        "--rdzv-endpoint",
        "10.1.0.10:9999",
        "${workspaceFolder}/scripts/train/pretrain.py"
      ]
    },
    {
      "name": "sinder",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "torch.distributed.run",
      "justMyCode": false,
      "env": {
        "NCCL_SOCKET_IFNAME": "ib",
        "NCCL_SOCKET_NTHREADS": "4",
        "NCCL_NSOCKS_PERTHREAD": "4",
        "OMP_NUM_THREADS": "16"
      },
      "args": [
        "--nnodes",
        "1",
        "--node_rank",
        "0",
        "--nproc_per_node",
        "1",
        "--rdzv-id",
        "2000",
        "--rdzv-backend",
        "c10d",
        "--rdzv-endpoint",
        "10.1.0.10:9999",
        "${workspaceFolder}/scripts/train/sinder.py"
      ]
    },
    {
      "name": "inference",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "torch.distributed.run",
      "justMyCode": false,
      "env": {
        "NCCL_SOCKET_IFNAME": "ib",
        "NCCL_SOCKET_NTHREADS": "4",
        "NCCL_NSOCKS_PERTHREAD": "4",
        "OMP_NUM_THREADS": "16"
      },
      "args": [
        "--nnodes",
        "1",
        "--node_rank",
        "0",
        "--nproc_per_node",
        "4",
        "--rdzv-id",
        "2000",
        "--rdzv-backend",
        "c10d",
        "${workspaceFolder}/scripts/inference/inference.py",
        "--file_path",
        "/nfs/scratch/Nchow/quantification/DataForCalculation/Figure_for_hypo_and_apili_enlargement/20250226_Zeiss_apili_svga_Ebola_vsvG/deskew/crop_x02/Ex01_560nm_100mW_642nm_100mW_z0p5/ch560nmCamA/DS",
        "--save_path",
        "/raid1/cme_tests/results/virus_apili"
      ]
    },
    {
      "name": "inference_pt2",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": false,
      "module": "torch.distributed.run",
      "env": {
        "CUDA_VISIBLE_DEVICES": "0,1,2,3,4",
        "NCCL_SOCKET_IFNAME": "ib",
        "NCCL_SOCKET_NTHREADS": "4",
        "NCCL_NSOCKS_PERTHREAD": "4",
        "OMP_NUM_THREADS": "16",
        "CUDA_LAUNCH_BLOCKING": "1"
      },
      "args": [
        "--nnodes",
        "1",
        "--node_rank",
        "0",
        "--nproc_per_node",
        "1",
        "${workspaceFolder}/scripts/inference/postprocessing.py",
