{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "save_files",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--save_3d",
        "--use_deskewed_data",
        "--dz",
        "0.25",
        "--dy",
        "0.104",
        "--dx",
        "0.104",
        "--z_flatten_mode",
        "NONE",
        "--z_chunk_size",
        "-1",
        "--y_chunk_size",
        "-1",
        "--x_chunk_size",
        "-1",
        "--data_paths_txt",
        "/nfs/scratch2/shared_image_recog_ml/annotations/experiment_paths.txt",
        "--save_path",
        "/nfs/scratch2/shared_image_recog_ml/llsm_3d_ds_auto_crop_sharded_v2",
        "--experiment_filter_pattern",
        "(?i)(dextran|lamp1|npc1|eea1|transferrin)",
        "--found_experiments_limit",
        "1000",
        "--min_tif_files",
        "20",
        "--max_workers",
        "1",
        "--auto_crop"
      ]
    },
    {
      "name": "pretrain",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "torch.distributed.run",
      "justMyCode": false,
      "env": {
        "NCCL_SOCKET_IFNAME": "ib",
        "NCCL_SOCKET_NTHREADS": "4",
        "NCCL_NSOCKS_PERTHREAD": "4",
        "OMP_NUM_THREADS": "16"
      },
      "args": [
        "--nnodes",
        "1",
        "--node_rank",
        "0",
        "--nproc_per_node",
        "1",
        "--rdzv-id",
        "2000",
        "--rdzv-backend",
        "c10d",
        "--rdzv-endpoint",
        "10.1.0.12:9999",
        "${workspaceFolder}/scripts/train/pretrain.py",
        "--config",
        "${workspaceFolder}/configs/pretrain.yaml"
      ]
    },
    {
      "name": "inference_3d",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": ["--config", "${workspaceFolder}/configs/inference.yaml"]
    }
  ]
}
