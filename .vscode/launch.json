{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Save files",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "--save_3d",
        "--use_deskewed_data",
        "--dz",
        "0.25",
        "--dy",
        "0.104",
        "--dx",
        "0.104",
        "--z_flatten_mode",
        "NONE",
        "--z_chunk_size",
        "-1",
        "--y_chunk_size",
        "-1",
        "--x_chunk_size",
        "-1",
        "--data_paths_txt",
        "/nfs/scratch2/shared_image_recog_ml/annotations/experiment_paths.txt",
        "--save_path",
        "/nfs/scratch2/shared_image_recog_ml/llsm_3d_ds_auto_crop_sharded_v2",
        "--experiment_filter_pattern",
        "(?i)(dextran|lamp1|npc1|eea1|transferrin)",
        "--found_experiments_limit",
        "1000",
        "--min_tif_files",
        "20",
        "--max_workers",
        "1"
      ]
    },
    {
      "name": "Lift",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train/train_lift.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "LOCAL_RANK": "0",
        "RANK": "0",
        "WORLD_SIZE": "1",
        "CUDA_VISIBLE_DEVICES": "2",
        "MASTER_PORT": "5001",
        "MASTER_ADDR": "10.1.0.11"
      }
    },
    {
      "name": "Train DINO3D",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train/train_dino3d.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "LOCAL_RANK": "0",
        "RANK": "0",
        "WORLD_SIZE": "1",
        "CUDA_VISIBLE_DEVICES": "0",
        "MASTER_ADDR": "10.1.0.10",
        "MASTER_PORT": "1234"
      }
    }
  ]
}
